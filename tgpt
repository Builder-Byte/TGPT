#!/usr/bin/env python3
"""
tgpt - Terminal GPT CLI tool
Quick access to AI from anywhere in your terminal (powered by Ollama)
"""
import sys
import json
import urllib.request
import urllib.error

OLLAMA_BASE_URL = "http://localhost:11434"
DEFAULT_MODEL = "qwen3-next:80b-cloud"

def get_available_models():
    """Fetch available models from Ollama."""
    try:
        req = urllib.request.urlopen(f"{OLLAMA_BASE_URL}/api/tags", timeout=5)
        data = json.loads(req.read().decode())
        return [m["name"] for m in data.get("models", [])]
    except Exception:
        return []

def check_ollama_running():
    """Check if Ollama is running."""
    try:
        urllib.request.urlopen(f"{OLLAMA_BASE_URL}/api/tags", timeout=3)
        return True
    except Exception:
        return False

def query_ai(prompt, model=DEFAULT_MODEL, long_answer=False):
    """Send query to Ollama and stream response."""
    try:
        if long_answer:
            final_prompt = f"Give a detailed, comprehensive explanation: {prompt}"
        else:
            final_prompt = f"Give a brief, concise answer in 1-2 sentences or a short paragraph: {prompt}"

        print("🤔 Thinking...\n")

        payload = json.dumps({
            "model": model,
            "messages": [{"role": "user", "content": final_prompt}],
            "stream": True,
            "options": {
                "num_predict": 4096 if long_answer else 1000
            }
        }).encode()

        req = urllib.request.Request(
            f"{OLLAMA_BASE_URL}/api/chat",
            data=payload,
            headers={"Content-Type": "application/json"},
            method="POST"
        )

        # Stream response — no timeout needed, chunks arrive continuously
        with urllib.request.urlopen(req) as response:
            for line in response:
                if not line.strip():
                    continue
                chunk = json.loads(line.decode())
                token = chunk.get("message", {}).get("content", "")
                if token:
                    print(token, end="", flush=True)
                if chunk.get("done"):
                    print()  # newline after final token
                    break

    except KeyboardInterrupt:
        print("\n\n⚠️  Request cancelled by user (Ctrl+C)")
    except urllib.error.URLError:
        print(
            f"Error: Cannot connect to Ollama at {OLLAMA_BASE_URL}\n"
            f"Make sure Ollama is running: ollama serve"
        )
    except Exception as e:
        print(f"Error: {str(e)}")

def main():
    """Main CLI function."""

    if len(sys.argv) < 2:
        print("Usage: tgpt [options] <your question>")
        print("Options:")
        print("  -l              Give long, detailed answers")
        print("  -m <model>      Specify Ollama model (default: llama3.2)")
        print("  --list-models   Show available Ollama models")
        print("  -h              Show this help message")
        print("\nExamples:")
        print("  tgpt 'What is Python?'                    # Short answer")
        print("  tgpt -l 'What is Python?'                 # Long answer")
        print("  tgpt -m mistral 'What is Python?'         # Use specific model")
        sys.exit(1)

    long_answer = False
    model = DEFAULT_MODEL
    query_parts = []
    skip_next = False

    args = sys.argv[1:]

    for i, arg in enumerate(args):
        if skip_next:
            skip_next = False
            continue

        if arg == "-l":
            long_answer = True
        elif arg == "-h":
            print("Usage: tgpt [options] <your question>")
            print("Options:")
            print("  -l              Give long, detailed answers")
            print("  -m <model>      Specify Ollama model (default: llama3.2)")
            print("  --list-models   Show available Ollama models")
            print("  -h              Show this help message")
            print("\nExamples:")
            print("  tgpt 'What is Python?'                    # Short answer (default)")
            print("  tgpt -l 'What is Python?'                 # Long answer")
            print("  tgpt -m mistral 'Explain recursion'       # Use specific model")
            print("\nBy default, tgpt gives brief, concise answers.")
            print("Use -l flag for detailed explanations.")
            sys.exit(0)
        elif arg == "--list-models":
            models = get_available_models()
            if models:
                print("Available Ollama models:")
                for m in models:
                    marker = " (default)" if m.startswith(DEFAULT_MODEL) else ""
                    print(f"  • {m}{marker}")
            else:
                print("No models found or Ollama is not running.")
                print("Pull a model with: ollama pull llama3.2")
            sys.exit(0)
        elif arg == "-m":
            if i + 1 < len(args):
                model = args[i + 1]
                skip_next = True
            else:
                print("Error: -m requires a model name")
                print("Example: tgpt -m mistral 'Your question'")
                sys.exit(1)
        else:
            query_parts.append(arg)

    if not query_parts:
        print("Error: No query provided")
        print("Usage: tgpt [options] <your question>")
        sys.exit(1)

    # Check Ollama is running before querying
    if not check_ollama_running():
        print(f"Error: Ollama is not running at {OLLAMA_BASE_URL}")
        print("Start it with: ollama serve")
        sys.exit(1)

    query = ' '.join(query_parts)
    query_ai(query, model=model, long_answer=long_answer)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\n Action terminated by user")
        sys.exit(0)
